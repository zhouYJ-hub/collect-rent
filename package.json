{
  "name": "zyj-collect-rent",
  "version": "1.0.0",
  "private": true,
  "description": "收房租 H5 —— 记录每月房租、水费、电费、燃气费和垃圾清理费",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
